# CLAUDE_API_KEY: Required for Claude AI (Anthropic) API calls.
# Get your key from https://console.anthropic.com/
CLAUDE_API_KEY="MY_CLAUDE_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# API backend
API_PORT="3001"
API_HOST="0.0.0.0"

# PostgreSQL local connection
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="sighos"

# Alternative single-string connection (optional)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sighos"
